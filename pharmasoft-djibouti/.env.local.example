# PHARMASOFT DJIBOUTI — Configuration DEPLOIEMENT LOCAL HORS-LIGNE
# ================================================================
# Copier ce fichier vers .env.local sur le SERVEUR de la pharmacie :
#   Copy-Item .env.local.example .env.local
# puis ajuster les valeurs ci-dessous (surtout AUTH_SECRET et l'IP du serveur).
#
# Next.js charge automatiquement .env.local en production (npm run start).

# ─── Base de données PostgreSQL LOCALE (sur le serveur) ─────────
# PostgreSQL est installé sur CE serveur → on pointe sur localhost.
# Format : postgresql://USER:PASSWORD@localhost:5432/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pharmasoft?schema=public"

# ─── Authentification (NextAuth v5 — local, sans internet) ──────
# Générer une clé unique :  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="REMPLACEZ-MOI-PAR-UNE-CLE-ALEATOIRE-32-OCTETS"

# NE PAS définir AUTH_URL en multi-postes !
# trustHost=true est codé en dur (src/lib/auth.config.ts) : NextAuth utilise
# automatiquement l'adresse par laquelle chaque poste accède au serveur.
# Fixer AUTH_URL à une seule adresse casse l'accès depuis les autres adresses/IP
# (les pages renvoient une erreur 404). On laisse donc AUTH_URL VIDE/absent.
# AUTH_URL=  ← laisser commenté

# Nombre de tours bcrypt (10 par défaut, 12 = plus sûr mais plus lent).
BCRYPT_ROUNDS="12"

# ─── Réseau ─────────────────────────────────────────────────────
# Port d'écoute du serveur (le script start utilise -H 0.0.0.0).
PORT="3000"

# ─── Sauvegardes ────────────────────────────────────────────────
# Dossier de destination des sauvegardes PostgreSQL.
# Conseillé : un disque externe / clé USB (ex : D:\PHARMASOFT-BACKUPS).
# Laisser vide = dossier ./backups dans le projet.
BACKUP_DIR="D:\PHARMASOFT-BACKUPS"

# Dossier des binaires PostgreSQL (pg_dump.exe / pg_restore.exe).
# Adapter à la version installée. Laisser vide si déjà dans le PATH Windows.
PG_BIN_DIR="C:\Program Files\PostgreSQL\16\bin"

# ─── Application ────────────────────────────────────────────────
NEXT_PUBLIC_DEFAULT_LOCALE="fr"
NEXT_PUBLIC_COUNTRY="DJ"
NEXT_PUBLIC_TIMEZONE="Africa/Djibouti"
NEXT_PUBLIC_CURRENCY="Fdj"
NEXT_PUBLIC_TVA_RATE="0.10"

# ─── Pharmacie (affichée dans les tickets/rapports) ─────────────
NEXT_PUBLIC_PHARMACY_NAME="Pharmacie Centrale Djibouti"
NEXT_PUBLIC_PHARMACY_ADDRESS="Avenue Maréchal Joffre, Plateau du Serpent"
NEXT_PUBLIC_PHARMACY_CITY="Djibouti-ville"
NEXT_PUBLIC_PHARMACY_PHONE="+253 21 35 12 34"
NEXT_PUBLIC_PHARMACY_NIF="12345-A"

# Désactive la télémétrie Next.js (aucun envoi réseau).
NEXT_TELEMETRY_DISABLED="1"
