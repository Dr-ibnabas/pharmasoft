# PHARMASOFT DJIBOUTI — Variables d'environnement
# Copier ce fichier vers .env puis renseigner les valeurs.

# ─── Base de données ───────────────────────────────────────────
# PostgreSQL local (Docker / installation native).
# Format : postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pharmasoft?schema=public"

# ─── NextAuth v5 (Auth.js) ─────────────────────────────────────
# Générer une clé via : openssl rand -base64 32
AUTH_SECRET="changez-moi-en-production-avec-une-cle-aleatoire-32-octets"

# AUTH_URL : NE PAS définir en déploiement local multi-postes.
# trustHost=true (src/lib/auth.config.ts) laisse NextAuth utiliser l'hôte de
# chaque requête → l'app marche depuis n'importe quelle IP/poste du LAN.
# Définir une URL fixe casserait l'accès depuis les autres adresses (404).

# Nombre de tours bcrypt pour le hash des mots de passe (10-12 en prod, 10 par défaut).
BCRYPT_ROUNDS="10"

# ─── Application ────────────────────────────────────────────────
# Langue par défaut : fr | en | ar
NEXT_PUBLIC_DEFAULT_LOCALE="fr"

# Pays / fuseau (par défaut Djibouti, Africa/Djibouti UTC+3).
NEXT_PUBLIC_COUNTRY="DJ"
NEXT_PUBLIC_TIMEZONE="Africa/Djibouti"

# Devise et TVA
NEXT_PUBLIC_CURRENCY="Fdj"
NEXT_PUBLIC_TVA_RATE="0.10"

# ─── Pharmacie (affichée dans les tickets/rapports) ─────────────
NEXT_PUBLIC_PHARMACY_NAME="Pharmacie Centrale Djibouti"
NEXT_PUBLIC_PHARMACY_ADDRESS="Avenue Maréchal Joffre, Plateau du Serpent"
NEXT_PUBLIC_PHARMACY_CITY="Djibouti-ville"
NEXT_PUBLIC_PHARMACY_PHONE="+253 21 35 12 34"
NEXT_PUBLIC_PHARMACY_NIF="12345-A"
